}


def atomic_write(path: Path, data: bytes, original: os.stat_result) -> None:
    fd, temporary = tempfile.mkstemp(prefix='.' + path.name + '.layout-state.', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
        os.chown(temporary, original.st_uid, original.st_gid)
        os.chmod(temporary, stat.S_IMODE(original.st_mode))
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def capture(state_path: Path) -> None:
    operations = []
    existing_stat = None
    if state_path.exists():
        if state_path.is_symlink() or not state_path.is_file():
            raise ValueError(f'unsafe state file: {state_path}')
        state = json.loads(state_path.read_text(encoding='utf-8'))
        if state.get('format') != 1 or not isinstance(state.get('operations'), list):
            raise ValueError('unsupported layout-state format')
        operations = state['operations']
        existing_stat = state_path.stat()

    contents = {}
    for path, replacements in PAIRS.items():
        if path.is_symlink() or not path.is_file():
            raise ValueError(f'unsafe or missing dashboard file: {path}')
        contents[path] = path.read_bytes()

    # Rebase ownership when the new layout transforms a prior replacement into its next safe value.
    # Upgrade v1.3.5 ownership to v1.3.6 while preserving the recorded pre-mod CSS.
    latest_by_previous = {old: new for replacements in PAIRS.values() for old, new in replacements}
    latest_overlay = '/* DVSwitch-Mods: responsive column alignment and compact header v1.3.7 */ .nav #modeInfo > fieldset { margin-top:8px !important; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > fieldset { margin-top:15px !important; } .nav #modeInfo > span:first-child { position:relative; top:-1px; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > span:first-child { position:relative; top:4px; } body:has(#dvs-asl-activity:not([hidden])) #dvs-asl-activity { position:relative; top:-1px; } body:has(#dvs-asl-activity:not([hidden])) #dvs-asl-activity > span { position:relative; top:-1px; } body:not(:has(#dvs-asl-activity:not([hidden]))) #lastHerd > span:first-child { position:relative; top:1px; } .header { padding:0; } .header h2 { margin:8px 0; } .container {'
    latest_by_previous['/* DVSwitch-Mods: responsive column alignment and compact header v1.3.0 */ .nav #modeInfo > fieldset { margin-top:15px !important; } .header { padding:0; } .header h2 { margin:8px 0; } .container {'] = latest_overlay
    latest_by_previous['/* DVSwitch-Mods: responsive column alignment and compact header v1.3.1 */ .nav #modeInfo > fieldset { margin-top:8px !important; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > fieldset { margin-top:15px !important; } .header { padding:0; } .header h2 { margin:8px 0; } .container {'] = latest_overlay
    latest_by_previous['/* DVSwitch-Mods: responsive column alignment and compact header v1.3.2 */ .nav #modeInfo > fieldset { margin-top:1px !important; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > fieldset { margin-top:15px !important; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > span:first-child { position:relative; top:6px; } body:has(#dvs-asl-activity:not([hidden])) #dvs-asl-activity > span { position:relative; top:6px; } .header { padding:0; } .header h2 { margin:8px 0; } .container {'] = latest_overlay
    latest_by_previous['/* DVSwitch-Mods: responsive column alignment and compact header v1.3.6 */ .nav #modeInfo > fieldset { margin-top:8px !important; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > fieldset { margin-top:15px !important; } .nav #modeInfo > span:first-child { position:relative; top:-1px; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > span:first-child { position:relative; top:4px; } body:has(#dvs-asl-activity:not([hidden])) #dvs-asl-activity { position:relative; top:-1px; } body:not(:has(#dvs-asl-activity:not([hidden]))) #lastHerd > span:first-child { position:relative; top:1px; } .header { padding:0; } .header h2 { margin:8px 0; } .container {'] = latest_overlay
    latest_by_previous['/* DVSwitch-Mods: responsive column alignment and compact header v1.3.5 */ .nav #modeInfo > fieldset { margin-top:8px !important; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > fieldset { margin-top:15px !important; } .nav #modeInfo > span:first-child { position:relative; top:-1px; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > span:first-child { position:relative; top:4px; } body:has(#dvs-asl-activity:not([hidden])) #dvs-asl-activity > span { position:relative; top:-1px; } .header { padding:0; } .header h2 { margin:8px 0; } .container {'] = latest_overlay
    latest_by_previous['/* DVSwitch-Mods: responsive column alignment and compact header v1.3.4 */ .nav #modeInfo > fieldset { margin-top:8px !important; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > fieldset { margin-top:15px !important; } .nav #modeInfo > span:first-child { position:relative; top:-1px; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > span:first-child { position:relative; top:4px; } body:has(#dvs-asl-activity:not([hidden])) #dvs-asl-activity { position:relative; top:-1px; } .header { padding:0; } .header h2 { margin:8px 0; } .container {'] = latest_overlay
    latest_by_previous['/* DVSwitch-Mods: responsive column alignment and compact header v1.3.3 */ .nav #modeInfo > fieldset { margin-top:8px !important; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > fieldset { margin-top:15px !important; } body:has(#dvs-asl-activity:not([hidden])) .nav #modeInfo > span:first-child { position:relative; top:4px; } .header { padding:0; } .header h2 { margin:8px 0; } .container {'] = latest_overlay
    allowed = {str(path) for path in PAIRS}
    for operation in operations:
        path = Path(operation['path'])
        if str(path) not in allowed or not isinstance(operation['count'], int) or operation['count'] < 1:
            raise ValueError('invalid layout-state operation')
        previous = operation['new']
        latest = latest_by_previous.get(previous)
        if latest and contents[path].count(latest.encode()) >= operation['count']:
            operation['new'] = latest

    # Capture newly introduced layout edits, including upgrades from an earlier Buttons state.
    covered = {}
    for operation in operations:
        for marker in (operation['old'], operation['new']):
            key = (operation['path'], marker)
            covered[key] = covered.get(key, 0) + operation['count']
    for path, replacements in PAIRS.items():
        data = contents[path]
        for old, new in replacements:
            key = (str(path), old)
            count = data.count(old.encode()) - covered.get(key, 0)
            if count > 0:
                operations.append({'path': str(path), 'old': old, 'new': new, 'count': count})
                covered[key] = covered.get(key, 0) + count
    state_path.parent.mkdir(parents=True, exist_ok=True)
    content = (json.dumps({'format': 1, 'operations': operations}, indent=2) + '\n').encode()
    if existing_stat and state_path.read_bytes() == content:
        return
    atomic_write(state_path, content, existing_stat or os.stat(state_path.parent))
    os.chmod(state_path, 0o600)


def restore(state_path: Path) -> None:
    if not state_path.exists():
        print('PASS: no Buttons-owned display-layout changes were recorded.')
        return
    if state_path.is_symlink() or not state_path.is_file():
        raise ValueError(f'unsafe state file: {state_path}')
    state = json.loads(state_path.read_text(encoding='utf-8'))
    if state.get('format') != 1 or not isinstance(state.get('operations'), list):
        raise ValueError('unsupported layout-state format')
    allowed = {str(path) for path in PAIRS}
    contents: dict[Path, bytes] = {}
    stats: dict[Path, os.stat_result] = {}
    for operation in state['operations']:
        path = Path(operation['path'])
        old, new, count = operation['old'].encode(), operation['new'].encode(), operation['count']
        if str(path) not in allowed or not isinstance(count, int) or count < 1:
            raise ValueError('invalid layout-state operation')
        if path.is_symlink() or not path.is_file():
            raise ValueError(f'unsafe or missing dashboard file: {path}')
        if path not in contents:
            contents[path] = path.read_bytes()
            stats[path] = path.stat()
        if contents[path].count(new) < count:
            raise ValueError(f'owned layout text changed or is missing in {path}')
    for operation in state['operations']:
        path = Path(operation['path'])
        contents[path] = contents[path].replace(
            operation['new'].encode(), operation['old'].encode(), operation['count']
        )
    staged: dict[Path, str] = {}
    try:
        for path, data in contents.items():
            fd, temporary = tempfile.mkstemp(prefix='.' + path.name + '.layout-restore.', dir=path.parent)
            with os.fdopen(fd, 'wb') as stream:
                stream.write(data)
            os.chown(temporary, stats[path].st_uid, stats[path].st_gid)
            os.chmod(temporary, stat.S_IMODE(stats[path].st_mode))
            staged[path] = temporary
        for path, temporary in staged.items():
            os.replace(temporary, path)
    finally:
        for temporary in staged.values():
            if os.path.exists(temporary):
                os.unlink(temporary)
    state_path.unlink()
    print('PASS: reverted only the display-layout substitutions owned by DVSwitch Mode Buttons.')


def check_restore(state_path: Path) -> None:
    if not state_path.exists():
        print('PASS: no Buttons-owned display-layout changes need rollback.')
        return
    if state_path.is_symlink() or not state_path.is_file():
        raise ValueError(f'unsafe state file: {state_path}')
    state = json.loads(state_path.read_text(encoding='utf-8'))
    if state.get('format') != 1 or not isinstance(state.get('operations'), list):
        raise ValueError('unsupported layout-state format')
    allowed = {str(path) for path in PAIRS}
    contents: dict[Path, bytes] = {}
    for operation in state['operations']:
        path = Path(operation['path'])
        count = operation['count']
        new = operation['new'].encode()
        if str(path) not in allowed or not isinstance(count, int) or count < 1:
            raise ValueError('invalid layout-state operation')
        if path.is_symlink() or not path.is_file():
            raise ValueError(f'unsafe or missing dashboard file: {path}')
        if path not in contents:
            contents[path] = path.read_bytes()
        if contents[path].count(new) < count:
            raise ValueError(f'owned layout text changed or is missing in {path}')
    print('PASS: recorded display-layout changes are safe to roll back.')


def main() -> None:
    if os.geteuid() != 0:
        raise SystemExit('ERROR: run with sudo.')
    if len(sys.argv) != 3 or sys.argv[1] not in ('capture', 'check-restore', 'restore'):
        raise SystemExit(f'Usage: {sys.argv[0]} {{capture|check-restore|restore}} STATE-FILE')
    state_path = Path(sys.argv[2])
    {'capture': capture, 'check-restore': check_restore, 'restore': restore}[sys.argv[1]](state_path)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as error:
        raise SystemExit(f'ERROR: {error}')
