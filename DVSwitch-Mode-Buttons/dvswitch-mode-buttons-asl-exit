"""Disconnect external ASL links before a Mode Buttons mode change."""

from __future__ import annotations

import os
from pathlib import Path
import re
import subprocess
import sys
import time

RPT_CONF = Path(os.environ.get("DVS_BUTTONS_RPT_CONF", "/etc/asterisk/rpt.conf"))
ASTERISK = os.environ.get("DVS_BUTTONS_ASTERISK", "/usr/sbin/asterisk")
POLL_SECONDS = 0.25
TIMEOUT_SECONDS = 10.0
NODE_HEADER = re.compile(rb"\[\s*(\d{1,8})\s*\]\s*(?:\([^)]*\))?\s*$")
ANY_HEADER = re.compile(rb"\[.*\]")


def clean_line(line: bytes) -> bytes:
    return line.split(b";", 1)[0].split(b"#", 1)[0].strip()


def local_nodes(data: bytes) -> tuple[str, str]:
    """Find the unique USRP bridge node and its paired local public node."""
    sections: list[tuple[str, list[bytes]]] = []
    current_node = ""
    current_lines: list[bytes] = []
    for raw in data.splitlines():
        line = clean_line(raw)
        if ANY_HEADER.match(line):
            if current_node:
                sections.append((current_node, current_lines))
            match = NODE_HEADER.fullmatch(line)
            current_node = match.group(1).decode("ascii") if match else ""
            current_lines = []
        elif current_node:
            current_lines.append(line)
    if current_node:
        sections.append((current_node, current_lines))

    bridge_nodes = [node for node, lines in sections
                    if any(re.match(rb"rxchannel\s*=\s*usrp(?:/|\s|$)", line, re.I)
                           for line in lines)]
    all_nodes = [node for node, _ in sections]
    if len(bridge_nodes) != 1:
        raise ValueError(f"expected one local USRP bridge node in {RPT_CONF}; found {len(bridge_nodes)}")
    private_node = bridge_nodes[0]
    public_nodes = [node for node in all_nodes if node != private_node]
    if len(public_nodes) != 1:
        raise ValueError(f"expected one local public node paired with {private_node}; found {len(public_nodes)}")
    return private_node, public_nodes[0]


def asterisk(command: str) -> str:
    result = subprocess.run([ASTERISK, "-rx", command], check=True, text=True,
                            capture_output=True, timeout=5)
    return result.stdout


def external_peers(output: str, private_node: str) -> list[str]:
    peers = []
    for line in output.splitlines():
        fields = line.split()
        if fields and fields[0].isdigit() and fields[0] != private_node:
            peers.append(fields[0])
    return peers


def disconnect_external_links() -> None:
    private_node, public_node = local_nodes(RPT_CONF.read_bytes())
    links = asterisk(f"rpt lstats {public_node}")
    peers = external_peers(links, private_node)
    for peer in peers:
        asterisk(f"rpt cmd {public_node} ilink 1 {peer}")
    if peers:
        deadline = time.monotonic() + TIMEOUT_SECONDS
        while time.monotonic() < deadline:
            links = asterisk(f"rpt lstats {public_node}")
            if not external_peers(links, private_node):
                break
            time.sleep(POLL_SECONDS)
        else:
            raise TimeoutError("an external ASL link remained after the disconnect request")
    print(f"PASS: external ASL links disconnected; private bridge {private_node} on public node {public_node} preserved.")


def main() -> int:
    if os.geteuid() != 0 and os.environ.get("DVS_BUTTONS_TESTING") != "1":
        print("ERROR: run this helper through the Mode Buttons root command.", file=sys.stderr)
        return 1
    try:
        disconnect_external_links()
    except (OSError, ValueError, subprocess.SubprocessError, TimeoutError) as error:
        print(f"ERROR: ASL links were not confirmed disconnected: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
