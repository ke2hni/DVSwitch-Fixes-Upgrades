set -Eeuo pipefail
umask 077

readonly RPT_CONF="/etc/asterisk/rpt.conf"
readonly ASTERISK="/usr/sbin/asterisk"
readonly RPT_CONF_TOOL="/usr/local/lib/dvswitch-asl3-support/asl3_rpt_conf.py"

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
[[ ${EUID:-$(id -u)} -eq 0 ]] || die 'Run through the dashboard sudo rule.'
[[ $# -eq 0 ]] || die 'This command reads the action and optional target from standard input.'
[[ -f "$RPT_CONF" && ! -L "$RPT_CONF" ]] || die "ASL configuration is unavailable: $RPT_CONF"
[[ -x "$ASTERISK" ]] || die "Asterisk command is unavailable: $ASTERISK"

request="$(cat)"
IFS=$'\t' read -r action target extra <<< "$request"
[[ -z "${extra:-}" ]] || die 'Invalid ASL link request.'
case "$action" in
    CONNECT) ilink=3 ;;
    DISCONNECT) ilink=1 ;;
    MONITOR) ilink=2 ;;
    LOCAL_MONITOR) ilink=8 ;;
    DISCONNECT_ALL) ilink='' ;;
    *) die 'Unsupported ASL link action.' ;;
esac
if [[ "$action" == DISCONNECT_ALL ]]; then
    [[ -z "${target:-}" ]] || die 'Disconnect All does not take a node number.'
else
    [[ "${target:-}" =~ ^[0-9]{1,8}$ ]] && ((10#$target > 0)) || die 'Enter a non-zero numeric AllStar node number.'
fi

[[ -f "$RPT_CONF_TOOL" && ! -L "$RPT_CONF_TOOL" ]] || die 'ASL rpt.conf helper is not installed.'
private_node=$(python3 "$RPT_CONF_TOOL" node "$RPT_CONF") || die 'Could not identify the local ASL node that connects to Analog_Bridge.'
nodes=$(python3 "$RPT_CONF_TOOL" nodes "$RPT_CONF") || die 'Could not read configured ASL node numbers.'
public_node=''
while IFS= read -r candidate; do
    [[ -n "$candidate" && "$candidate" != "$private_node" ]] || continue
    links=$("$ASTERISK" -rx "rpt lstats $candidate" 2>/dev/null) || continue
    if awk -v node="$private_node" '$1 == node { found=1 } END { exit !found }' <<< "$links"; then
        [[ -z "$public_node" ]] || die 'More than one local ASL node links to the private DVSwitch bridge; refusing an ambiguous command.'
        public_node=$candidate
    fi
done <<< "$nodes"
[[ -n "$public_node" ]] || die 'Could not identify the local public ASL node linked to the private DVSwitch bridge.'

if [[ "$action" == DISCONNECT_ALL ]]; then
    links=$("$ASTERISK" -rx "rpt lstats $public_node" 2>&1) || die "Could not list links on local public ASL node $public_node: $links"
    disconnected=0
    while IFS= read -r peer; do
        [[ -n "$peer" && "$peer" != "$private_node" ]] || continue
        result=$("$ASTERISK" -rx "rpt cmd $public_node ilink 1 $peer" 2>&1) || die "Could not disconnect external ASL node $peer: $result"
        printf '%s\n' "$result"
        disconnected=$((disconnected + 1))
    done < <(awk -v keep="$private_node" '$1 ~ /^[0-9]+$/ && $1 != keep { print $1 }' <<< "$links")
    printf 'PASS: disconnected %s external ASL link(s) on node %s; preserved private bridge node %s.\n' "$disconnected" "$public_node" "$private_node"
else
    result=$("$ASTERISK" -rx "rpt cmd $public_node ilink $ilink $target" 2>&1) || die "Asterisk rejected the link command: $result"
    printf '%s\n' "$result"
    if [[ "$action" == CONNECT && -x /usr/local/sbin/dvswitch-mode-targets ]]; then /usr/local/sbin/dvswitch-mode-targets save ASL "$target" >/dev/null || true; fi
    printf 'PASS: requested %s on local public ASL node %s for node %s.\n' "$action" "$public_node" "$target"
fi
