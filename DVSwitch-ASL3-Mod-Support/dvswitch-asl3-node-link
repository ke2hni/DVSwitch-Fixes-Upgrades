set -Eeuo pipefail
umask 077

readonly RPT_CONF="/etc/asterisk/rpt.conf"
readonly ANALOG_BRIDGE_CONF="/opt/Analog_Bridge/Analog_Bridge.ini"
readonly ASTERISK="/usr/sbin/asterisk"
readonly RPT_CONF_TOOL="/usr/local/lib/dvswitch-asl3-support/asl3_rpt_conf.py"

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
[[ ${EUID:-$(id -u)} -eq 0 ]] || die 'Run through the dashboard sudo rule.'
[[ $# -eq 0 ]] || die 'This command reads the action and optional target from standard input.'
[[ -f "$RPT_CONF" && ! -L "$RPT_CONF" ]] || die "ASL configuration is unavailable: $RPT_CONF"
[[ -x "$ASTERISK" ]] || die "Asterisk command is unavailable: $ASTERISK"

request="$(cat)"
IFS=$'\t' read -r action target option extra <<< "$request"
[[ -z "${extra:-}" ]] || die 'Invalid ASL link request.'
case "$action" in
    CONNECT) ilink=3 ;;
    DISCONNECT) ilink=1 ;;
    MONITOR) ilink=2 ;;
    LOCAL_MONITOR) ilink=8 ;;
    DISCONNECT_ALL) ilink='' ;;
    ENSURE_BRIDGE) ilink=3 ;;
    SWITCH_PRIVATE|SWITCH_DVSWITCH) ilink=3 ;;
    *) die 'Unsupported ASL link action.' ;;
esac
[[ -z "${option:-}" || ( "$action" == CONNECT && "$option" == DISCONNECT_BEFORE_CONNECT ) ]] || die 'Disconnect before Connect is valid only for Connect.'
if [[ "$action" == DISCONNECT_ALL || "$action" == ENSURE_BRIDGE || "$action" == SWITCH_DVSWITCH ]]; then
    [[ -z "${target:-}" ]] || die 'Disconnect All does not take a node number.'
else
    [[ "${target:-}" =~ ^[0-9]{1,8}$ ]] && ((10#$target > 0)) || die 'Enter a non-zero numeric AllStar node number.'
fi

[[ -f "$RPT_CONF_TOOL" && ! -L "$RPT_CONF_TOOL" ]] || die 'ASL rpt.conf helper is not installed.'
private_node=$(python3 "$RPT_CONF_TOOL" node "$RPT_CONF" --analog-bridge "$ANALOG_BRIDGE_CONF") || die 'Could not identify the local DVSwitch private node that connects to Analog_Bridge.'
private_nodes=$(python3 "$RPT_CONF_TOOL" private-nodes "$RPT_CONF") || die 'Could not identify configured private USRP nodes.'
public_node=$(python3 "$RPT_CONF_TOOL" public-node "$RPT_CONF") || die 'Could not identify the local public ASL node from rpt.conf.'

switch_private_node() {
    local selected=$1 links peers peer result attempt cleared=0
    [[ "$selected" =~ ^[0-9]{1,8}$ ]] || die 'Private node selection is invalid.'
    grep -Fxq -- "$selected" <<< "$private_nodes" || die "Node $selected is not configured as a private USRP node."
    links=$("$ASTERISK" -rx "rpt lstats $public_node" 2>&1) || die "Could not list private-node links on public node $public_node: $links"
    # Disconnect every other private USRP endpoint first; this prevents private-node audio crossfeed.
    peers=$(awk -v privates="$private_nodes" -v selected="$selected" 'BEGIN { count=split(privates, ids, "\n"); for (i=1; i<=count; i++) private[ids[i]]=1 } $1 ~ /^[0-9]+$/ && private[$1] && $1 != selected { print $1 }' <<< "$links" | sort -u)
    while IFS= read -r peer; do
        [[ -n "$peer" ]] || continue
        result=$("$ASTERISK" -rx "rpt cmd $public_node ilink 1 $peer" 2>&1) || die "Could not disconnect private node $peer: $result"
        printf '%s\n' "$result"
    done <<< "$peers"
    # Wait for other private links to clear before connecting the selected endpoint.
    for attempt in {1..40}; do
        links=$("$ASTERISK" -rx "rpt lstats $public_node" 2>&1) || die "Could not verify private-node disconnections: $links"
        if ! awk -v privates="$private_nodes" -v selected="$selected" 'BEGIN { count=split(privates, ids, "\n"); for (i=1; i<=count; i++) private[ids[i]]=1 } $1 ~ /^[0-9]+$/ && private[$1] && $1 != selected && $NF == "ESTABLISHED" { found=1 } END { exit !found }' <<< "$links"; then
            cleared=1
            break
        fi
        (( attempt == 40 )) || sleep 0.25
    done
    (( cleared == 1 )) || die 'Another private-node link remained established; refusing to connect the selected node.'
    if ! awk -v node="$selected" '$1 == node && $NF == "ESTABLISHED" { found=1 } END { exit !found }' <<< "$links"; then
        result=$("$ASTERISK" -rx "rpt cmd $public_node ilink 3 $selected" 2>&1) || die "Could not connect private node $selected: $result"
        printf '%s\n' "$result"
        wait_for_connection "$selected"
    else
        printf 'PASS: private node %s is the only established private link on public node %s.\n' "$selected" "$public_node"
    fi
}

ensure_bridge() {
    local links result attempt active_private
    links=$("$ASTERISK" -rx "rpt lstats $public_node" 2>&1) || die "Could not list links on local public ASL node $public_node: $links"
    # Preserve one already-active alternate private node so dashboard actions cannot create audio crossfeed.
    active_private=$(awk -v privates="$private_nodes" -v keep="$private_node" 'BEGIN { count=split(privates, ids, "\n"); for (i=1; i<=count; i++) private[ids[i]]=1 } $1 ~ /^[0-9]+$/ && private[$1] && $1 != keep && $NF == "ESTABLISHED" { print $1 }' <<< "$links")
    if [[ -n "$active_private" ]]; then
        [[ "$active_private" != *$'\n'* ]] || die 'Multiple alternate private nodes are already established; use m17 or dvs-dvswitch to select one.'
        printf 'PASS: private node %s is active; preserving the exclusive link instead of reconnecting DVSwitch.\n' "$active_private"
        return 0
    fi
    if ! awk -v node="$private_node" '$1 == node && $NF == "ESTABLISHED" { found=1 } END { exit !found }' <<< "$links"; then
        result=$("$ASTERISK" -rx "rpt cmd $public_node ilink 3 $private_node" 2>&1) || die "Could not establish the private-to-public bridge: $result"
        # Poll at 250ms but keep the original ten-second bridge-establishment limit.
        for attempt in {1..40}; do
            links=$("$ASTERISK" -rx "rpt lstats $public_node" 2>&1) || die "Could not verify the local ASL bridge: $links"
            if awk -v node="$private_node" '$1 == node && $NF == "ESTABLISHED" { found=1 } END { exit !found }' <<< "$links"; then
                printf 'PASS: private bridge node %s is established on local public node %s.\n' "$private_node" "$public_node"
                return 0
            fi
            sleep 0.25
        done
        die "Private bridge node $private_node did not establish on local public node $public_node."
    fi
    printf 'PASS: private bridge node %s is already established on local public node %s.\n' "$private_node" "$public_node"
}

disconnect_external_links() {
    local links peers peer result attempt
    links=$("$ASTERISK" -rx "rpt lstats $public_node" 2>&1) || die "Could not list links on local public ASL node $public_node: $links"
    peers=$(awk -v keep="$private_node" '$1 ~ /^[0-9]+$/ && $1 != keep { print $1 }' <<< "$links")
    while IFS= read -r peer; do
        [[ -n "$peer" ]] || continue
        result=$("$ASTERISK" -rx "rpt cmd $public_node ilink 1 $peer" 2>&1) || die "Could not disconnect external ASL node $peer: $result"
        printf '%s\n' "$result"
    done <<< "$peers"
    # Verify external links every 250ms for at most five seconds before allowing a mode change.
    for attempt in {1..21}; do
        links=$("$ASTERISK" -rx "rpt lstats $public_node" 2>&1) || die "Could not verify external ASL disconnections: $links"
        if ! awk -v keep="$private_node" '$1 ~ /^[0-9]+$/ && $1 != keep { found=1 } END { exit found ? 0 : 1 }' <<< "$links"; then
            printf 'PASS: external ASL links are disconnected; private bridge node %s remains protected.\n' "$private_node"
            return 0
        fi
        (( attempt == 21 )) || sleep 0.25
    done
    die 'An external ASL link remained established after the disconnect request.'
}

# Verify the remote link on the public node; rpt cmd can return before it is established.
wait_for_connection() {
    local target_node=$1 links attempt
    for attempt in {1..120}; do
        links=$("$ASTERISK" -rx "rpt lstats $public_node" 2>&1) || die "Could not verify connection on local public ASL node $public_node: $links"
        if awk -v node="$target_node" '$1 == node && $NF == "ESTABLISHED" { found=1 } END { exit !found }' <<< "$links"; then
            printf 'PASS: external node %s is established on local public ASL node %s.\n' "$target_node" "$public_node"
            return 0
        fi
        sleep 0.25
    done
    die "Connect was sent to local public ASL node $public_node, but external node $target_node did not reach ESTABLISHED state within 30 seconds."
}

if [[ "$action" == ENSURE_BRIDGE ]]; then
    ensure_bridge
elif [[ "$action" == DISCONNECT_ALL ]]; then
    disconnect_external_links
elif [[ "$action" == SWITCH_PRIVATE ]]; then
    switch_private_node "$target"
elif [[ "$action" == SWITCH_DVSWITCH ]]; then
    switch_private_node "$private_node"
else
    if [[ "$action" == CONNECT || "$action" == MONITOR || "$action" == LOCAL_MONITOR ]]; then ensure_bridge; fi
    # Replace external links only when Connect explicitly requests it; the helper always excludes the private bridge.
    if [[ "$action" == CONNECT && "${option:-}" == DISCONNECT_BEFORE_CONNECT ]]; then disconnect_external_links; fi
    result=$("$ASTERISK" -rx "rpt cmd $public_node ilink $ilink $target" 2>&1) || die "Asterisk rejected the link command: $result"
    printf '%s\n' "$result"
    # Report Connect as successful only after the requested node is live on the public node.
    if [[ "$action" == CONNECT ]]; then wait_for_connection "$target"; fi
    # ASL favorites are stored by the ASL-owned dashboard endpoint, not the optional Mode Buttons target helper.
    if [[ "$action" != CONNECT ]]; then printf 'PASS: requested %s on local public ASL node %s for node %s.\n' "$action" "$public_node" "$target"; fi
fi
