set -Eeuo pipefail
umask 077
[[ ${EUID:-$(id -u)} -eq 0 ]] || exit 2
[[ $# -eq 3 ]] || exit 2
event=$1
local_node=$2
remote_node=$3
[[ "$local_node" =~ ^[0-9]{1,8}$ && "$remote_node" =~ ^[0-9]{1,8}$ ]] || exit 2
if [[ -f /usr/local/lib/dvswitch-asl3-support/asl3_rpt_conf.py ]]; then
    private_node=$(python3 /usr/local/lib/dvswitch-asl3-support/asl3_rpt_conf.py node /etc/asterisk/rpt.conf 2>/dev/null || true)
    [[ -z "$private_node" || "$remote_node" != "$private_node" ]] || exit 0
fi
case "$event" in
    CONNECTED) label=Connected ;;
    DISCONNECTED) label=Disconnected ;;
    *) exit 2 ;;
esac
install -d -o root -g www-data -m 0750 /var/lib/dvswitch-mods
stamp=$(date +%s)
printf '%s\t%s\t%s\t%s\n' "$stamp" "$remote_node" "$local_node" "$label" >> /var/lib/dvswitch-mods/asl3-link-activity.tsv
chown root:www-data /var/lib/dvswitch-mods/asl3-link-activity.tsv
chmod 0640 /var/lib/dvswitch-mods/asl3-link-activity.tsv
tail -n 500 /var/lib/dvswitch-mods/asl3-link-activity.tsv > /var/lib/dvswitch-mods/.asl3-link-activity.tsv
chown root:www-data /var/lib/dvswitch-mods/.asl3-link-activity.tsv
chmod 0640 /var/lib/dvswitch-mods/.asl3-link-activity.tsv
mv -f /var/lib/dvswitch-mods/.asl3-link-activity.tsv /var/lib/dvswitch-mods/asl3-link-activity.tsv
