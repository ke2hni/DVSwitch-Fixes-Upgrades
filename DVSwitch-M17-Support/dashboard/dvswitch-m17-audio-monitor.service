# DVSwitch-M17-Audio-Monitor v1.0.0
# Created: 2026-11-11T16:20:00-05:00 by KE2HNI
[Unit]
Description=DVSwitch M17 RX audio monitor
After=network.target usrp2m17.service
Wants=usrp2m17.service
[Service]
Type=simple
User=root
ExecStart=/usr/local/sbin/dvswitch-m17-audio-monitor
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_PACKET
[Install]
WantedBy=multi-user.target
