#!/usr/bin/env bash
# Version: 1.0.1
# Created: 2026-11-09T00:41:12-05:00 by KE2HNI
# Updated: 2026-11-10T15:20:00-05:00 by KE2HNI — call the M17-owned exclusive switch helper.
# DVSwitch-M17-Support: switch the public AllStar node exclusively back to Analog_Bridge.

set -Eeuo pipefail
readonly LINK_HELPER=/usr/local/sbin/dvswitch-m17-node-link
readonly SUDO=/usr/bin/sudo
[[ $# -eq 0 ]] || { printf 'ERROR: This command takes no arguments.\n' >&2; exit 1; }
[[ -x "$LINK_HELPER" && -x "$SUDO" ]] || { printf 'ERROR: M17 private-node switching support is not installed.\n' >&2; exit 1; }
printf 'SWITCH_DVSWITCH\n' | "$SUDO" "$LINK_HELPER"
